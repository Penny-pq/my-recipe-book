/* ==========================================================================
   暖心廚房日誌 (Cozy Kitchen Journal) 全站樣式表
   色彩與排版遵循 AGENTS.md 第 2 節設計規範
   ========================================================================== */

:root {
  --bg-cream: #FAF7F2;
  --bg-card: #FFFFFF;
  --accent-terracotta: #C85A32;
  --accent-terracotta-light: #FDF1EC;
  --accent-sage: #4A6B5D;
  --accent-sage-light: #EEF4F1;
  --text-primary: #2C2520;
  --text-secondary: #6E655F;
  --border-sand: #E8E0D5;
  --shadow-soft: 0 4px 20px rgba(44, 37, 32, 0.06);
  --shadow-hover: 0 10px 28px rgba(200, 90, 50, 0.12);
  --radius-lg: 16px;
  --radius-md: 10px;
}

* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

body {
  font-family: "Noto Sans TC", "PingFang TC", "Microsoft JhengHei", sans-serif;
  background-color: var(--bg-cream);
  color: var(--text-primary);
  line-height: 1.7;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
}

.container {
  width: 100%;
  max-width: 1080px;
  margin: 0 auto;
  padding: 0 20px;
}

.hidden {
  display: none !important;
}

/* Header */
.site-header {
  background-color: var(--bg-card);
  border-bottom: 1px solid var(--border-sand);
  padding: 20px 0;
  position: sticky;
  top: 0;
  z-index: 20;
}

.header-inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
}

.brand {
  display: flex;
  align-items: center;
  gap: 14px;
  text-decoration: none;
  color: inherit;
}

.brand-icon {
  font-size: 2.2rem;
  background: var(--accent-terracotta-light);
  width: 52px;
  height: 52px;
  border-radius: 14px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.brand-title {
  font-size: 1.4rem;
  font-weight: 700;
  letter-spacing: 0.02em;
  color: var(--text-primary);
}

.brand-subtitle {
  font-size: 0.85rem;
  color: var(--text-secondary);
}

.recipe-counter {
  background: var(--accent-sage-light);
  color: var(--accent-sage);
  font-size: 0.85rem;
  font-weight: 700;
  padding: 6px 14px;
  border-radius: 999px;
}

/* Main Content */
.main-content {
  flex: 1;
  padding-top: 32px;
  padding-bottom: 56px;
}

/* Controls Bar */
.controls-bar {
  display: flex;
  flex-direction: column;
  gap: 16px;
  margin-bottom: 28px;
}

.search-box {
  position: relative;
  display: flex;
  align-items: center;
}

.search-icon {
  position: absolute;
  left: 16px;
  font-size: 1rem;
  pointer-events: none;
}

#search-input {
  width: 100%;
  padding: 13px 18px 13px 44px;
  font-size: 0.98rem;
  font-family: inherit;
  border: 1.5px solid var(--border-sand);
  border-radius: var(--radius-md);
  background: var(--bg-card);
  color: var(--text-primary);
  transition: border-color 0.2s, box-shadow 0.2s;
}

#search-input:focus {
  outline: none;
  border-color: var(--accent-terracotta);
  box-shadow: 0 0 0 3px rgba(200, 90, 50, 0.12);
}

.category-tabs {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
}

.tab-btn {
  padding: 8px 16px;
  border-radius: 999px;
  border: 1px solid var(--border-sand);
  background: var(--bg-card);
  color: var(--text-secondary);
  font-size: 0.9rem;
  font-weight: 500;
  font-family: inherit;
  cursor: pointer;
  transition: all 0.2s;
}

.tab-btn:hover {
  border-color: var(--accent-terracotta);
  color: var(--accent-terracotta);
}

.tab-btn.active {
  background: var(--accent-terracotta);
  border-color: var(--accent-terracotta);
  color: #FFFFFF;
}

/* Recipe Cards Grid */
.recipe-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(310px, 1fr));
  gap: 24px;
}

.recipe-card {
  background: var(--bg-card);
  border: 1px solid var(--border-sand);
  border-radius: var(--radius-lg);
  padding: 24px;
  box-shadow: var(--shadow-soft);
  cursor: pointer;
  transition: transform 0.22s ease, box-shadow 0.22s ease, border-color 0.22s ease;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.recipe-card:hover {
  transform: translateY(-4px);
  box-shadow: var(--shadow-hover);
  border-color: var(--accent-terracotta);
}

.card-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 14px;
}

.card-emoji {
  font-size: 2.3rem;
  background: var(--bg-cream);
  width: 56px;
  height: 56px;
  border-radius: 14px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.card-category {
  font-size: 0.8rem;
  font-weight: 700;
  color: var(--accent-terracotta);
  background: var(--accent-terracotta-light);
  padding: 4px 12px;
  border-radius: 999px;
}

.card-title {
  font-size: 1.22rem;
  font-weight: 700;
  margin-bottom: 8px;
  color: var(--text-primary);
}

.card-subtitle {
  font-size: 0.92rem;
  color: var(--text-secondary);
  margin-bottom: 18px;
  line-height: 1.55;
}

.card-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 12px;
  font-size: 0.84rem;
  color: var(--accent-sage);
  font-weight: 500;
  padding-top: 14px;
  border-top: 1px dashed var(--border-sand);
}

.card-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
  margin-top: 12px;
}

.tag-pill {
  font-size: 0.78rem;
  color: var(--text-secondary);
  background: var(--bg-cream);
  padding: 2px 10px;
  border-radius: 6px;
}

/* Empty State */
.empty-state {
  text-align: center;
  padding: 64px 20px;
  background: var(--bg-card);
  border-radius: var(--radius-lg);
  border: 1px dashed var(--border-sand);
}

.empty-emoji {
  font-size: 3rem;
  margin-bottom: 12px;
}

/* Detail View */
.back-btn {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  background: var(--bg-card);
  border: 1px solid var(--border-sand);
  color: var(--text-primary);
  padding: 9px 18px;
  border-radius: 999px;
  font-size: 0.92rem;
  font-weight: 500;
  font-family: inherit;
  cursor: pointer;
  margin-bottom: 20px;
  transition: all 0.2s;
}

.back-btn:hover {
  border-color: var(--accent-terracotta);
  color: var(--accent-terracotta);
}

.recipe-article {
  background: var(--bg-card);
  border: 1px solid var(--border-sand);
  border-radius: var(--radius-lg);
  padding: 36px;
  box-shadow: var(--shadow-soft);
}

.article-hero {
  border-bottom: 1px solid var(--border-sand);
  padding-bottom: 24px;
  margin-bottom: 28px;
}

.article-hero-top {
  display: flex;
  align-items: center;
  gap: 16px;
  margin-bottom: 12px;
}

.article-emoji {
  font-size: 2.8rem;
  background: var(--accent-terracotta-light);
  width: 68px;
  height: 68px;
  border-radius: 18px;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.article-title {
  font-size: 1.85rem;
  font-weight: 700;
  line-height: 1.3;
}

.article-subtitle {
  color: var(--text-secondary);
  font-size: 1.02rem;
  margin-top: 4px;
}

.article-stats {
  display: flex;
  flex-wrap: wrap;
  gap: 12px;
  margin-top: 18px;
}

.stat-badge {
  background: var(--bg-cream);
  border: 1px solid var(--border-sand);
  padding: 6px 14px;
  border-radius: 10px;
  font-size: 0.88rem;
  font-weight: 500;
}

.article-intro {
  background: var(--bg-cream);
  padding: 18px 22px;
  border-radius: var(--radius-md);
  border-left: 4px solid var(--accent-terracotta);
  margin-bottom: 30px;
  color: var(--text-primary);
}

/* Two-Column Kitchen Layout */
.kitchen-layout {
  display: grid;
  grid-template-columns: 300px 1fr;
  gap: 32px;
  align-items: start;
}

.ingredients-panel {
  background: var(--bg-cream);
  border: 1px solid var(--border-sand);
  border-radius: var(--radius-md);
  padding: 22px;
}

.panel-heading {
  font-size: 1.15rem;
  font-weight: 700;
  color: var(--accent-terracotta);
  margin-bottom: 14px;
  display: flex;
  align-items: center;
  gap: 8px;
}

.ingredient-list {
  list-style: none;
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.ingredient-item label {
  display: flex;
  align-items: flex-start;
  gap: 10px;
  cursor: pointer;
  font-size: 0.94rem;
}

.ingredient-item input[type="checkbox"] {
  margin-top: 5px;
  accent-color: var(--accent-sage);
  width: 16px;
  height: 16px;
  cursor: pointer;
}

.ingredient-item input[type="checkbox"]:checked + span {
  text-decoration: line-through;
  color: var(--text-secondary);
}

.steps-list {
  list-style: none;
  display: flex;
  flex-direction: column;
  gap: 18px;
}

.step-item {
  display: flex;
  gap: 16px;
  align-items: flex-start;
  padding-bottom: 18px;
  border-bottom: 1px dashed var(--border-sand);
}

.step-item:last-child {
  border-bottom: none;
  padding-bottom: 0;
}

.step-num {
  background: var(--accent-terracotta);
  color: #FFFFFF;
  font-weight: 700;
  font-size: 0.9rem;
  width: 30px;
  height: 30px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-top: 2px;
}

.step-text {
  font-size: 0.98rem;
  line-height: 1.75;
}

.chef-tips {
  margin-top: 32px;
  background: var(--accent-sage-light);
  border: 1px solid rgba(74, 107, 93, 0.25);
  border-radius: var(--radius-md);
  padding: 22px 24px;
}

.chef-tips h3 {
  color: var(--accent-sage);
  font-size: 1.1rem;
  margin-bottom: 10px;
}

.chef-tips ul {
  padding-left: 20px;
  display: flex;
  flex-direction: column;
  gap: 8px;
  font-size: 0.94rem;
}

/* Footer */
.site-footer {
  border-top: 1px solid var(--border-sand);
  background: var(--bg-card);
  padding: 20px 0;
  text-align: center;
  font-size: 0.86rem;
  color: var(--text-secondary);
}

.site-footer code {
  background: var(--bg-cream);
  padding: 2px 6px;
  border-radius: 4px;
  color: var(--accent-terracotta);
}

/* Responsive */
@media (max-width: 768px) {
  .header-inner {
    flex-direction: column;
    align-items: flex-start;
  }

  .recipe-article {
    padding: 22px 18px;
  }

  .article-title {
    font-size: 1.45rem;
  }

  .kitchen-layout {
    grid-template-columns: 1fr;
  }
}
